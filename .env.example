# =========================
# Django Core Settings
# =========================
SECRET_KEY=your_django_secret_key_here
DEBUG=True

# =========================
# Database Configuration (MySQL)
# =========================
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=3306

# =========================
# External Database Configuration
# =========================
EXTERNAL_DB_CONN_MAX_AGE=300
EXTERNAL_DB_CONNECT_TIMEOUT=10

XBYTES_DB_NAME=xbytesdata
XBYTES_DB_USER=your_xbytes_user
XBYTES_DB_PASSWORD=your_xbytes_password
XBYTES_DB_HOST=127.0.0.1
XBYTES_DB_PORT=3306

KARMATECH_DB_NAME=compx_db
KARMATECH_DB_USER=your_karmatech_user
KARMATECH_DB_PASSWORD=your_karmatech_password
KARMATECH_DB_HOST=127.0.0.1
KARMATECH_DB_PORT=3306

# =========================
# CORS / Security
# =========================
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# =========================
# Celery (Redis)
# =========================
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# =========================
# Email (optional - for auth/verification)
# =========================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=True

# =========================
# Admin Seeder (IMPORTANT)
# =========================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password
